{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "warn",
    "import/no-duplicates": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    // tsconfig uses jsx: "react-jsx", so the automatic runtime injects the factory itself.
    "react/react-in-jsx-scope": "off",
    // Stylesheets are imported for their side effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "env": { "node": true },
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist/", "src/data/projects.json"]
}
